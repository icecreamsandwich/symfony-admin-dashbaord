{% extends 'base.html.twig' %}

{% block title %}Manage Users{% endblock %}

{% block body %}
    <section class="panel">
        <div class="panel-header">
            <div>
                <p class="eyebrow">Admin</p>
                <h1>Manage Users</h1>
                <p class="muted">Create, edit, and delete administrator accounts.</p>
            </div>
            <a class="button" href="{{ path('app_admin_user_new') }}">Add User</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="flash flash-success">{{ message }}</div>
        {% endfor %}

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Roles</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.email }}</td>
                            <td>{{ user.roles is empty ? 'ROLE_USER' : user.roles|join(', ') }}</td>
                            <td class="actions">
                                <a class="button button-secondary" href="{{ path('app_admin_user_edit', {id: user.id}) }}">Edit</a>
                                <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Delete this user?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                    <button class="button button-danger" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">No users found.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
