<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Firmware Manager{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <style>
                :root {
                    --bg: #ede5d8;
                    --panel: #fffdf9;
                    --panel-alt: #fff6e8;
                    --ink: #241c15;
                    --muted: #64584d;
                    --line: #d9cfc2;
                    --brand: #8d4f16;
                    --brand-dark: #6b3708;
                    --header-bg: #2f2117;
                    --header-accent: #f0d8b2;
                    --header-ink: #fff7ed;
                    --sidebar-bg: rgba(255, 248, 238, 0.82);
                    --danger: #ad2e24;
                    --success-bg: #edf8ef;
                    --success-ink: #1d6a31;
                    --error-bg: #fff0ee;
                    --error-ink: #8e1f15;
                    --shadow: 0 20px 60px rgba(50, 35, 18, 0.12);
                }

                * { box-sizing: border-box; }

                body {
                    margin: 0;
                    font-family: Georgia, "Times New Roman", serif;
                    color: var(--ink);
                    background:
                        radial-gradient(circle at top left, rgba(230, 179, 111, 0.28), transparent 30%),
                        linear-gradient(180deg, #f8f3ec 0%, var(--bg) 100%);
                }

                a { color: var(--brand); }
                code { background: #f3e7d6; padding: 0.12rem 0.4rem; border-radius: 0.35rem; }

                .site-shell {
                    max-width: 1240px;
                    margin: 0 auto;
                    padding: 1.25rem 1rem 2rem;
                }

                .site-header,
                .site-footer {
                    display: flex;
                    justify-content: space-between;
                    gap: 1rem;
                    align-items: center;
                    padding: 1rem 1.35rem;
                    background: linear-gradient(135deg, var(--header-bg) 0%, #4d311d 100%);
                    color: var(--header-ink);
                    border-radius: 1.5rem;
                    box-shadow: var(--shadow);
                }

                .site-header {
                    margin-bottom: 1.5rem;
                }

                .site-footer {
                    margin-top: 1.5rem;
                    font-size: 0.95rem;
                }

                .site-header a,
                .site-footer a {
                    color: var(--header-accent);
                }

                .site-nav-links {
                    display: flex;
                    gap: 0.75rem;
                    flex-wrap: wrap;
                    align-items: center;
                }

                .brand {
                    text-decoration: none;
                    color: var(--header-ink);
                    font-size: 1.2rem;
                    font-weight: 700;
                    letter-spacing: 0.03em;
                }

                .brand-mark {
                    display: inline-flex;
                    width: 2.25rem;
                    height: 2.25rem;
                    border-radius: 999px;
                    align-items: center;
                    justify-content: center;
                    background: rgba(240, 216, 178, 0.16);
                    border: 1px solid rgba(240, 216, 178, 0.32);
                    margin-right: 0.75rem;
                    font-size: 0.92rem;
                }

                .brand-wrap {
                    display: flex;
                    align-items: center;
                }

                .layout-grid {
                    display: grid;
                    grid-template-columns: 260px minmax(0, 1fr);
                    gap: 1.5rem;
                    align-items: start;
                }

                .sidebar {
                    background: var(--sidebar-bg);
                    border: 1px solid rgba(141, 79, 22, 0.16);
                    border-radius: 1.5rem;
                    box-shadow: var(--shadow);
                    padding: 1.1rem;
                    position: sticky;
                    top: 1rem;
                    backdrop-filter: blur(14px);
                }

                .sidebar-title {
                    margin: 0 0 0.75rem;
                    font-size: 0.9rem;
                    text-transform: uppercase;
                    letter-spacing: 0.14em;
                    color: var(--brand);
                }

                .sidebar-nav {
                    display: grid;
                    gap: 0.35rem;
                }

                .sidebar-link {
                    display: block;
                    padding: 0.75rem 0.9rem;
                    border-radius: 0.95rem;
                    text-decoration: none;
                    color: var(--ink);
                }

                .sidebar-link:hover,
                .sidebar-link.is-active {
                    background: rgba(141, 79, 22, 0.12);
                    color: var(--brand-dark);
                }

                .sidebar-divider {
                    height: 1px;
                    margin: 0.85rem 0;
                    background: var(--line);
                }

                .content-area {
                    min-width: 0;
                }

                .hero-card,
                .panel,
                .warning-card {
                    background: var(--panel);
                    border: 1px solid rgba(141, 79, 22, 0.18);
                    box-shadow: var(--shadow);
                    border-radius: 1.5rem;
                    padding: 1.5rem;
                    margin-bottom: 1.5rem;
                }

                .warning-card {
                    background: var(--panel-alt);
                }

                .panel-narrow {
                    max-width: 780px;
                    margin-inline: auto;
                }

                .panel-header,
                .toolbar,
                .actions {
                    display: flex;
                    gap: 0.75rem;
                    align-items: center;
                    justify-content: space-between;
                    flex-wrap: wrap;
                }

                h1, h2, h3 { margin-top: 0; }

                .eyebrow {
                    text-transform: uppercase;
                    letter-spacing: 0.18em;
                    font-size: 0.76rem;
                    color: var(--brand);
                    margin-bottom: 0.75rem;
                    font-weight: 700;
                }

                .muted { color: var(--muted); }

                .stack,
                .stack-sm {
                    display: grid;
                    gap: 1rem;
                }

                .stack-sm { gap: 0.35rem; }

                .button {
                    display: inline-flex;
                    justify-content: center;
                    align-items: center;
                    border-radius: 999px;
                    background: var(--brand);
                    color: white;
                    border: 0;
                    padding: 0.8rem 1.2rem;
                    text-decoration: none;
                    cursor: pointer;
                    font: inherit;
                }

                .button:hover { background: var(--brand-dark); }
                .button-secondary { background: transparent; color: var(--brand); border: 1px solid var(--brand); }
                .button-danger { background: var(--danger); }
                .text-link { color: inherit; text-decoration: none; }

                .user-menu {
                    position: relative;
                }

                .user-menu summary {
                    list-style: none;
                    cursor: pointer;
                    display: inline-flex;
                    align-items: center;
                    gap: 0.7rem;
                    padding: 0.5rem 0.8rem;
                    border-radius: 999px;
                    border: 1px solid rgba(240, 216, 178, 0.24);
                    background: rgba(255, 247, 237, 0.08);
                    color: var(--header-ink);
                }

                .user-menu summary::-webkit-details-marker {
                    display: none;
                }

                .user-avatar {
                    width: 2rem;
                    height: 2rem;
                    border-radius: 999px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    background: rgba(240, 216, 178, 0.18);
                    border: 1px solid rgba(240, 216, 178, 0.28);
                    font-size: 0.8rem;
                    text-transform: uppercase;
                }

                .user-menu-panel {
                    position: absolute;
                    right: 0;
                    top: calc(100% + 0.55rem);
                    width: 200px;
                    background: var(--panel);
                    border: 1px solid rgba(141, 79, 22, 0.2);
                    border-radius: 1rem;
                    box-shadow: var(--shadow);
                    padding: 0.45rem;
                    z-index: 20;
                }

                .user-menu-item {
                    display: block;
                    width: 100%;
                    text-align: left;
                    border: 0;
                    background: transparent;
                    color: var(--ink);
                    padding: 0.75rem 0.85rem;
                    border-radius: 0.8rem;
                    cursor: pointer;
                    text-decoration: none;
                    font: inherit;
                }

                .user-menu-item:hover {
                    background: rgba(141, 79, 22, 0.1);
                }

                .user-menu-label {
                    display: grid;
                    gap: 0.1rem;
                }

                .footer-meta {
                    display: flex;
                    gap: 1rem;
                    align-items: center;
                    flex-wrap: wrap;
                }

                table {
                    width: 100%;
                    border-collapse: collapse;
                }

                th,
                td {
                    text-align: left;
                    padding: 0.9rem 0.75rem;
                    border-bottom: 1px solid var(--line);
                    vertical-align: top;
                }

                .table-wrap { overflow-x: auto; }

                form label {
                    display: block;
                    font-weight: 700;
                    margin-bottom: 0.35rem;
                }

                input[type="email"],
                input[type="password"],
                input[type="text"],
                input:not([type]),
                textarea {
                    width: 100%;
                    padding: 0.85rem 1rem;
                    border: 1px solid var(--line);
                    border-radius: 0.85rem;
                    background: #fff;
                    color: var(--ink);
                    font: inherit;
                }

                input[disabled] {
                    background: #f3eee8;
                    color: #7a6d61;
                }

                .form-grid {
                    display: grid;
                    gap: 1rem;
                }

                .flash,
                .result {
                    border-radius: 1rem;
                    padding: 1rem 1.1rem;
                    margin: 1rem 0;
                }

                .flash-success,
                .result-success {
                    background: var(--success-bg);
                    color: var(--success-ink);
                }

                .result-error {
                    background: var(--error-bg);
                    color: var(--error-ink);
                }

                .form-error-message { color: var(--danger); }
                .help-text { color: var(--muted); font-size: 0.95rem; }

                @media (max-width: 720px) {
                    .site-shell { padding-top: 1rem; }

                    .site-header,
                    .site-footer {
                        flex-direction: column;
                        align-items: flex-start;
                    }

                    .layout-grid {
                        grid-template-columns: 1fr;
                    }

                    .sidebar {
                        position: static;
                    }
                }
            </style>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}
    </head>
    <body>
        {% set current_route = app.request.attributes.get('_route') %}
        {% set app_version = 'v1.0.0' %}

        <div class="site-shell">
            <header class="site-header">
                <a class="brand text-link" href="{{ app.user ? path('app_admin_dashboard') : path('app_home') }}">
                    <span class="brand-wrap">
                        <span class="brand-mark">SF</span>
                        Symfony Firmware Manager
                    </span>
                </a>

                <div class="site-nav-links">
                    {% if app.user %}
                        <details class="user-menu">
                            <summary>
                                <span class="user-avatar">{{ app.user.userIdentifier|slice(0, 1) }}</span>
                                <span class="user-menu-label">
                                    <strong>User</strong>
                                    <span>{{ app.user.userIdentifier }}</span>
                                </span>
                            </summary>
                            <div class="user-menu-panel">
                                <a class="user-menu-item" href="{{ path('app_profile') }}">Profile</a>
                                <a class="user-menu-item" href="{{ path('app_logout') }}">Logout</a>
                            </div>
                        </details>
                    {% else %}
                        <a class="sidebar-link {{ current_route == 'app_home' ? 'is-active' : '' }}" href="{{ path('app_home') }}">Home</a>
                        <a class="sidebar-link {{ (current_route ?? '') starts with 'app_firmware_download' ? 'is-active' : '' }}" href="{{ path('app_firmware_download') }}">Download Firmwares</a>
                        <a class="sidebar-link {{ current_route == 'app_login' ? 'is-active' : '' }}" href="{{ path('app_login') }}">Admin Login</a>
                    {% endif %}
                </div>
            </header>

            <div class="layout-grid">
                <aside class="sidebar">
                    {% if app.user %}
                        <p class="sidebar-title">Navigation</p>
                        <nav class="sidebar-nav">
                            <a class="sidebar-link {{ current_route == 'app_admin_dashboard' ? 'is-active' : '' }}" href="{{ path('app_admin_dashboard') }}">Dashboard</a>
                            <a class="sidebar-link {{ (current_route ?? '') starts with 'app_admin_firmware_' ? 'is-active' : '' }}" href="{{ path('app_admin_firmware_index') }}">Manage Firmwares</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="sidebar-divider"></div>
                                <a class="sidebar-link {{ (current_route ?? '') starts with 'app_admin_user_' ? 'is-active' : '' }}" href="{{ path('app_admin_user_index') }}">Manage Users</a>
                            {% endif %}
                        </nav>
                    {% else %}
                        <p class="sidebar-title">Explore</p>
                        <nav class="sidebar-nav">
                            <a class="sidebar-link {{ current_route == 'app_home' ? 'is-active' : '' }}" href="{{ path('app_home') }}">Landing Page</a>
                            <a class="sidebar-link {{ (current_route ?? '') starts with 'app_firmware_download' ? 'is-active' : '' }}" href="{{ path('app_firmware_download') }}">Firmware Lookup</a>
                            <a class="sidebar-link {{ current_route == 'app_login' ? 'is-active' : '' }}" href="{{ path('app_login') }}">Admin Login</a>
                        </nav>
                        <div class="sidebar-divider"></div>
                        <p class="muted">Admins can sign in from the menu. End users can stay on the frontend flow without authentication.</p>
                    {% endif %}

                    {% block sidebar %}{% endblock %}
                </aside>

                <main class="content-area">
                    {% block body %}{% endblock %}
                </main>
            </div>

            <footer class="site-footer">
                <strong>Symfony Firmware Manager</strong>
                <div class="footer-meta">
                    <span>Version {{ app_version }}</span>
                    <span>&copy; 2026 Muneeb</span>
                </div>
            </footer>
        </div>
    </body>
</html>
